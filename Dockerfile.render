# ============================================
# PRODUCTION-READY DOCKERFILE FOR NEXT.JS + BUN
# ============================================
# Multi-stage build with Tor support
# ============================================

# Stage 1: Base with build dependencies
FROM oven/bun:1-debian AS base
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Stage 2: Install dependencies
FROM base AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Stage 3: Build the application
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN mkdir -p public
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run build
RUN bun install --frozen-lockfile --production

# Stage 4: Production runtime with Tor
FROM oven/bun:1-debian AS runner
WORKDIR /app

# Install Tor and curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tor \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs

# Configure Tor for non-root user
RUN mkdir -p /var/lib/tor /var/run/tor /var/log/tor && \
    chown -R nextjs:nodejs /var/lib/tor /var/run/tor /var/log/tor && \
    chmod 700 /var/lib/tor

# Create Tor config for non-root user
RUN echo "SocksPort 9050" > /etc/tor/torrc && \
    echo "ControlPort 9051" >> /etc/tor/torrc && \
    echo "CookieAuthentication 0" >> /etc/tor/torrc && \
    echo "DataDirectory /var/lib/tor" >> /etc/tor/torrc && \
    echo "Log notice file /var/log/tor/notices.log" >> /etc/tor/torrc && \
    echo "RunAsDaemon 0" >> /etc/tor/torrc && \
    chown nextjs:nodejs /etc/tor/torrc && \
    chmod 644 /etc/tor/torrc

# Set environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy application files
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./
COPY --from=builder --chown=nextjs:nodejs /app/server.js ./
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Create startup script with better Tor handling
RUN printf '#!/bin/bash\n\
    set -e\n\
    \n\
    echo "=== Starting Tor daemon ==="\n\
    # Start Tor and capture output\n\
    tor -f /etc/tor/torrc &\n\
    TOR_PID=$!\n\
    echo "Tor started with PID: $TOR_PID"\n\
    \n\
    # Give Tor a moment to initialize\n\
    sleep 3\n\
    \n\
    # Check if Tor is still running\n\
    if kill -0 $TOR_PID 2>/dev/null; then\n\
    echo "Tor is running"\n\
    else\n\
    echo "WARNING: Tor failed to start. Continuing without Tor."\n\
    cat /var/log/tor/notices.log 2>/dev/null || echo "No Tor logs available"\n\
    fi\n\
    \n\
    echo "=== Starting Next.js application ==="\n\
    echo "Binding to ${HOSTNAME}:${PORT}"\n\
    exec bun run start\n' > /app/start.sh && \
    chmod +x /app/start.sh && \
    chown nextjs:nodejs /app/start.sh

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT}/api/relay || exit 1

# Start the application
CMD ["/bin/bash", "/app/start.sh"]
