# ============================================
# PRODUCTION-READY DOCKERFILE FOR NEXT.JS + BUN
# ============================================
# Multi-stage build with Tor support
# ============================================

# Stage 1: Base with build dependencies
FROM oven/bun:1-debian AS base
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Stage 2: Install dependencies
FROM base AS deps
WORKDIR /app
COPY package.json bun.lock ./
# Electron is a desktop-only dependency: its postinstall downloads a ~100MB
# binary that the relay never runs, and a failed download fails the whole build.
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN bun install --frozen-lockfile

# Stage 3: Build the application
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN mkdir -p public
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN bun run build
RUN bun install --frozen-lockfile --production

# Stage 4: Production runtime with Tor
FROM oven/bun:1-debian AS runner
WORKDIR /app

# Install Tor and curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tor \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs

# Tor's data directory and log must both be writable by the user running it.
RUN mkdir -p /var/lib/tor /var/run/tor /var/log/tor && \
    chown -R nextjs:nodejs /var/lib/tor /var/run/tor /var/log/tor && \
    chmod 700 /var/lib/tor

# ControlPort and SocksPort are pinned to loopback: nothing outside this
# container may request a circuit through them or read circuit state.
# CookieAuthentication means only a process that can read Tor's cookie file -
# which lives inside this container - can drive the control port.
RUN printf '%s\n' \
    'SocksPort 127.0.0.1:9050' \
    'ControlPort 127.0.0.1:9051' \
    'CookieAuthentication 1' \
    'CookieAuthFile /var/lib/tor/control_auth_cookie' \
    'DataDirectory /var/lib/tor' \
    'Log notice file /var/log/tor/notices.log' \
    'RunAsDaemon 0' \
    > /etc/tor/torrc && \
    chown nextjs:nodejs /etc/tor/torrc && \
    chmod 644 /etc/tor/torrc

# Set environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV TOR_CONTROL_PORT=9051
ENV TOR_SOCKS_PORT=9050
ENV TOR_CONTROL_COOKIE=/var/lib/tor/control_auth_cookie

# Copy application files
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./
COPY --from=builder --chown=nextjs:nodejs /app/server.js ./
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/scripts ./scripts

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# /api/health answers 200 whenever the process can route, and reports Tor
# separately in the body - so a Tor outage degrades the report instead of
# marking a perfectly good relay unhealthy.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT}/api/health" || exit 1

# Start Tor, wait for its control port, then start the relay
CMD ["/bin/bash", "/app/scripts/render-start.sh"]
