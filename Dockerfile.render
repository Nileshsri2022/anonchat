# ============================================
# PRODUCTION-READY DOCKERFILE FOR NEXT.JS + BUN
# ============================================
# Multi-stage build with Tor support
# App starts immediately, Tor connects in background
# ============================================

# Stage 1: Base with build dependencies
FROM oven/bun:1-debian AS base
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Stage 2: Install dependencies
FROM base AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Stage 3: Build the application
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN mkdir -p public
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run build
RUN bun install --frozen-lockfile --production

# Stage 4: Production runtime with Tor
FROM oven/bun:1-debian AS runner
WORKDIR /app

# Install Tor and curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tor \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs

# Configure Tor directories
RUN mkdir -p /var/lib/tor /var/run/tor && \
    chown -R nextjs:nodejs /var/lib/tor /var/run/tor && \
    chmod 700 /var/lib/tor

# Create Tor config - allow passwordless control port access
RUN echo "SocksPort 9050" > /etc/tor/torrc && \
    echo "ControlPort 9051" >> /etc/tor/torrc && \
    echo "CookieAuthentication 0" >> /etc/tor/torrc && \
    echo "DataDirectory /var/lib/tor" >> /etc/tor/torrc && \
    echo "RunAsDaemon 0" >> /etc/tor/torrc && \
    echo "Log notice stdout" >> /etc/tor/torrc && \
    chown nextjs:nodejs /etc/tor/torrc

# Set environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy application files
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./
COPY --from=builder --chown=nextjs:nodejs /app/server.js ./
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Create startup script
# KEY: Start Tor in background, then start app IMMEDIATELY
# This ensures port 3000 opens fast so Render doesn't timeout
RUN printf '#!/bin/bash\n\
    echo "=== Starting Tor in background ==="\n\
    tor > /tmp/tor.log 2>&1 &\n\
    echo "Tor PID: $!"\n\
    \n\
    echo "=== Starting Next.js application ==="\n\
    echo "Binding to ${HOSTNAME}:${PORT}"\n\
    exec bun run start\n' > /app/start.sh && \
    chmod +x /app/start.sh && \
    chown nextjs:nodejs /app/start.sh

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Health check (only checks app, Tor may take time to connect)
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT}/api/relay || exit 1

# Start the application (Tor starts first but doesn't block)
CMD ["/bin/bash", "/app/start.sh"]
