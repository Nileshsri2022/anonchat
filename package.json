{
  "name": "anonchat",
  "version": "0.1.6",
  "private": true,
  "description": "Anonymous encrypted chat over Tor network",
  "author": "AnonChat Team",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "next build",
    "dev": "bun run server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run server.js",
    "electron": "electron .",
    "electron-dev": "concurrently \"cross-env BROWSER=none bun run server.js\" \"wait-on http://localhost:3000 && electron .\"",
    "build:next": "next build",
    "build:electron": "bun run build:next && electron-builder",
    "build:win": "bun run build:next && electron-builder --win",
    "build:mac": "bun run build:next && electron-builder --mac",
    "build:linux": "bun run build:next && electron-builder --linux",
    "dist": "bun run build:electron"
  },
  "build": {
    "appId": "com.anonchat.app",
    "productName": "AnonChat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json",
      "server.js",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/tor",
        "to": "tor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "maintainer": "AnonChat Team <anonchat@example.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true
  },
  "dependencies": {
    "@noble/post-quantum": "^0.7.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tailwindcss/postcss": "^4.0.0",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^14.2.18",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "socks-proxy-agent": "^8.0.5",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.3",
    "electron-builder": "^26.7.0",
    "eslint": "8",
    "eslint-config-next": "14",
    "knip": "^6.42.1",
    "tw-animate-css": "^1.3.3",
    "typescript": "^5.7.3",
    "wait-on": "^9.0.3"
  }
}